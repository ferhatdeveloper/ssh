# ============================================================================
# WebSSH + WGDashboard ortam değişkenleri
# ============================================================================
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizle doldurun:
#   cp .env.example .env
# Sonra Caddy'yi yeniden başlatın:
#   docker compose restart caddy
# ============================================================================

# ----- Caddy / TLS ---------------------------------------------------------
# DNS'te bu sunucunun public IP'sine yönlendirilmiş iki alan adı (A kaydı).
# Caddy, Let's Encrypt'ten otomatik sertifika alır.
WEBSSH_DOMAIN=ssh.example.com
WGD_DOMAIN=wgd.example.com

# ----- (Opsiyonel) Doğrudan port yayını -------------------------------------
# Caddy reverse proxy üzerinden erişmek istemiyorsanız, docker-compose.yaml'da
# ilgili port satırlarının yorumunu kaldırıp bu env'leri kullanabilirsiniz:
# WEBSSH_PORT=3000
# WGD_PORT=10086
# WGPORT=51820

# ============================================================================
# AI Asistan (OpenRouter) — API anahtarı frontend'de (chat balonu ⚙ ayarı)
# girilir, bu .env dosyasına yazılmaz. Aşağıdaki yorum sadece referans içindir:
#
#   OPENROUTER_API_KEY=sk-or-...    # https://openrouter.ai/keys adresinden alın
#   OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Ücretsiz modeller için kayıt + kredi kartı gerekmez.
# ============================================================================
