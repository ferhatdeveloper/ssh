# WebSSH için reverse proxy
# Caddy, bu domain için Let's Encrypt'ten otomatik TLS sertifikası alır.
#
# Değişkenler:
#   {$PUBLIC_DOMAIN:wssh.retailex.app}  → ortam değişkeninden okunur,
#                                       yoksa fallback olarak wssh.retailex.app kullanılır.

{$PUBLIC_DOMAIN:wssh.retailex.app} {
    reverse_proxy webssh:3000
    encode gzip
}
